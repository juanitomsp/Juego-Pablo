# Copia este fichero como .env (no lo subas a git) y rellena lo que necesites.

# --- Cliente (Vite: solo las variables VITE_* llegan al navegador) ---

# URL del servidor de juego, SOLO si el cliente se aloja en otro dominio (p. ej. Vercel + Render).
# Si cliente y servidor van juntos (npm start / Docker), déjala vacía.
VITE_SERVER_URL=

# Cuentas opcionales con Google (Firebase). Si se dejan vacías, no hay inicio de sesión
# y las estadísticas se guardan solo en el navegador. Ver docs/CUENTAS_Y_DATOS.md.
# (La configuración web de Firebase no es secreta: la protegen las reglas de firestore.rules.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Imágenes propias de las cartas (ver docs/CARTAS.md). Vacío = dibujos incluidos.
VITE_CARD_IMAGES=

# --- Servidor ---
# PORT=3001
# 1 si hay un proxy delante (Render, Caddy, nginx). NO lo actives sin proxy.
# TRUST_PROXY=1
# Máximo de salas simultáneas:
# MAX_ROOMS=500
# Orígenes permitidos (separados por comas) si el cliente está en otro dominio:
# CORS_ORIGIN=https://tu-juego.vercel.app
